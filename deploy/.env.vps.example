# VPS Production Environment — notification-mcp
# Copy to /opt/notification-mcp/.env.vps on the VPS
# NEVER commit this file with real credentials

# PostgreSQL (use openssl rand -hex 24 for passwords)
MCP_POSTGRES_USER=mcp
MCP_POSTGRES_PASSWORD=CHANGE_ME_HEX_PASSWORD
MCP_POSTGRES_DB=notification_mcp

# MCP server secret (openssl rand -hex 32)
SECRET_KEY=CHANGE_ME_HEX_SECRET_32

# notification-engine credentials (from /opt/notification-engine/.env.vps)
# APP_CLIENTS value format: key:secret  e.g. demo-app:mysecret
SERVICE_API_KEY=CHANGE_ME_APP_KEY
SERVICE_API_SECRET=CHANGE_ME_APP_SECRET
