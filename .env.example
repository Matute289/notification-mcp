# NotificationEngine connection
NOTIFICATION_ENGINE_BASE_URL=http://localhost:8080
NOTIFICATION_ENGINE_APP_KEY=your-app-key-here
NOTIFICATION_ENGINE_APP_SECRET=your-app-secret-here

# HTTP client
HTTP_TIMEOUT_S=10
HTTP_MAX_CONNECTIONS=50
HTTP_VERIFY_TLS=true

# MCP transport (sse | http)
MCP_TRANSPORT=sse
MCP_HOST=127.0.0.1
MCP_PORT=8765
MCP_LOG_LEVEL=INFO

# Template in-process cache TTL in seconds (0 = disabled)
TEMPLATE_CACHE_TTL_S=300
